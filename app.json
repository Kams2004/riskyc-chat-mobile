{
  "expo": {
    "name": "RiskyC Chat",
    "slug": "riskyc-chat",
    "version": "1.0.0",
    "scheme": "riskycchat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ff1a5e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RiskyC Chat needs camera access to scan a contact's QR code and start a chat with them."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RiskyC Chat needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RiskyC Chat needs microphone access to record voice messages."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff1a5e",
          "defaultChannel": "messages",
          "sounds": [
            "./assets/sounds/notification.wav",
            "./assets/sounds/ringtone.wav"
          ]
        }
      ],
      "expo-video",
      [
        "expo-contacts",
        {
          "contactsPermission": "RiskyC Chat uses your contacts to show you which of your friends are already using the app — only phone numbers/emails are checked against accounts, nothing is uploaded or shared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riskyc.chat",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.riskyc.chat",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "e0f80034-a6ce-48b3-972d-87085f08a5c4"
      }
    },
    "owner": "ulrich2004"
  }
}
