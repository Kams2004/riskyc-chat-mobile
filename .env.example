# Copy to .env.local (already gitignored) and adjust for your setup.
# These are inlined into the JS bundle at build time — no secrets here.
#
# Defaults baked into src/lib/config.ts already point at the deployed VPS,
# so you only need a .env.local for LOCAL backend development — point these
# at localhost (or your machine's LAN IP, for a physical device on Expo Go)
# instead:
EXPO_PUBLIC_AUTH_SERVICE_URL=http://localhost:8081
EXPO_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:8082
EXPO_PUBLIC_MEDIA_SERVICE_URL=http://localhost:8083
EXPO_PUBLIC_PRESENCE_SERVICE_URL=http://localhost:8084
